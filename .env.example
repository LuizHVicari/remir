# Local dev config. Copy to `.env` (git-ignored) and adjust to your machine:
#   cp .env.example .env
# Read by `docker compose` and by `./gradlew :server:run`.

# Postgres. DATABASE_PORT is the HOST port docker compose publishes; change it if 5432 is taken
# (e.g. a native Postgres). To use a Postgres you already run, skip compose and point these at it.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=remir
DATABASE_USER=remir
DATABASE_PASSWORD=remir

# Server
PORT=8080
# Clerk Frontend API URL (Dashboard > API keys), e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
