<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is backed up or transferred. Real data lives on the server, and restoring the
     local Clerk session onto another device would leave it in an inconsistent sign-in state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
